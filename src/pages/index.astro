  <script is:inline>
    const drawer = document.querySelector('#mobileDrawer');
    const toggle = document.querySelector('#mobileMenuToggle');
    const closeItems = document.querySelectorAll('[data-close-menu], .mobile-nav a');
    const setDrawer = (open) => {
      if (!drawer || !toggle) return;
      drawer.classList.toggle('open', open);
      drawer.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
    };
    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      setDrawer(!drawer?.classList.contains('open'));
    });
    closeItems.forEach((item) => item.addEventListener('click', () => setDrawer(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setDrawer(false);
    });

    // Hero Reveal Animation (Somente Desktop/Tablet)
    const startHeroReveal = () => {
      if (!window.matchMedia('(min-width: 761px)').matches) {
        return;
      }
      const heroContainer = document.querySelector('.hero-content');
      if (!heroContainer) return;

      const heroBadge = heroContainer.querySelector('.hero-badge');
      const heroTitle = heroContainer.querySelector('h1');
      const heroDescription = heroContainer.querySelector('.hero-description');
      const heroActions = heroContainer.querySelector('.hero-actions');
      const trustBar = document.querySelector('.trust-bar');

      const splitHeroWords = (element) => {
        if (!element) return [];
        const words = [];
        const items = [];

        const traverse = (node, isHighlight) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const tokens = (node.textContent || '').trim().split(/\s+/).filter(Boolean);
            tokens.forEach((t) => items.push({ type: 'word', text: t, isHighlight }));
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            if (node.tagName.toLowerCase() === 'br') {
              items.push({ type: 'break' });
            } else {
              const highlight = isHighlight || node.classList.contains('highlight') || node.tagName.toLowerCase() === 'span';
              Array.from(node.childNodes).forEach((child) => traverse(child, highlight));
            }
          }
        };

        Array.from(element.childNodes).forEach((child) => traverse(child, false));

        element.replaceChildren();
        items.forEach((item) => {
          if (item.type === 'break') {
            element.appendChild(document.createElement('br'));
          } else {
            const span = document.createElement('span');
            span.className = `hero-reveal-word${item.isHighlight ? ' highlight' : ''}`;
            span.textContent = item.text;
            element.append(span, ' ');
            words.push(span);
          }
        });

        return words;
      };

      const scheduleHeroWords = (words, startDelay) => {
        let line = 0;
        let wordInLine = 0;
        let previousTop = null;

        words.forEach((word) => {
          const currentTop = word.offsetTop;
          if (previousTop !== null && Math.abs(currentTop - previousTop) > 2) {
            line += 1;
            wordInLine = 0;
          }
          word.style.setProperty('--hero-delay', `${startDelay + line * 0.06 + wordInLine * 0.015}s`);
          wordInLine += 1;
          previousTop = currentTop;
        });

        return line + 1;
      };

      const titleWords = splitHeroWords(heroTitle);
      const descWords = splitHeroWords(heroDescription);

      heroContainer.classList.add('hero-reveal-ready');
      trustBar?.classList.add('hero-reveal-ready');

      const badgeDelay = 0;
      const titleDelay = 0.05;
      const titleLines = scheduleHeroWords(titleWords, titleDelay);

      const descDelay = titleDelay + titleLines * 0.06 + 0.12;
      const descLines = scheduleHeroWords(descWords, descDelay);

      const actionsDelay = descDelay + descLines * 0.06 + 0.12;
      const trustDelay = actionsDelay + 0.15;

      heroBadge?.style.setProperty('--hero-delay', `${badgeDelay}s`);
      heroActions?.querySelectorAll(':scope > *').forEach((item, index) => {
        item.style.setProperty('--hero-delay', `${actionsDelay + index * 0.06}s`);
      });
      trustBar?.style.setProperty('--hero-delay', `${trustDelay}s`);
    };

    let heroRevealed = false;
    const triggerHeroReveal = () => {
      if (heroRevealed) return;
      heroRevealed = true;
      startHeroReveal();
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(triggerHeroReveal);
      setTimeout(triggerHeroReveal, 350);
    } else {
      triggerHeroReveal();
    }
  </script>
</BaseLayout>
