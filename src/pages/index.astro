---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutBenefits, faqs, processSteps, reviews, services, site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const whatsapp = (subject: string) => `${site.phoneLink}%20Sobre%20${encodeURIComponent(subject)}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.seo.description,
  url: site.seo.url,
  image: `${site.seo.url}${site.seo.ogImage}`,
  telephone: "+5551992285222",
  sameAs: [site.googleProfile, site.instagram],
  address: {
    "@type": "PostalAddress",
    streetAddress: "Rua Caeté, 19",
    addressLocality: site.city,
    addressRegion: site.state,
    postalCode: site.postalCode,
    addressCountry: "BR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -29.6781317,
    longitude: -51.137551,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    bestRating: "5",
    reviewCount: `${reviews.length}`,
  },
};
---
<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" as="image" href={asset(site.assets.hero)} fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
  <header class="site-header" id="siteHeader">
    <div class="container header-container">
      <a href="#inicio" class="header-logo" aria-label="Easy Wash Lavanderia Autoatendimento - Página inicial">
        <img src={asset(site.assets.logo)} alt="Easy Wash Lavanderia Autoatendimento" width="220" height="60" fetchpriority="high" />
      </a>
      <nav class="site-nav" aria-label="Navegação principal">
        <ul class="nav-list">
          <li><a href="#servicos" class="nav-link active">Serviços</a></li>
          <li><a href="#como-funciona" class="nav-link">Como funciona</a></li>
          <li><a href="#vantagens" class="nav-link">Vantagens</a></li>
          <li><a href="#sobre" class="nav-link">Sobre</a></li>
          <li><a href="#avaliacoes" class="nav-link">Avaliações</a></li>
          <li><a href="#contato" class="nav-link">Contato</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-header-whatsapp">
          <svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/>
          </svg>
          <span>Falar no WhatsApp</span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Abrir menu de navegação" aria-expanded="false" aria-controls="mobileDrawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="mobile-drawer-panel">
      <div class="mobile-drawer-header">
        <div class="mobile-drawer-brand">
          <img src={asset(site.assets.logo)} alt="Easy Wash Lavanderia Autoatendimento" width="180" height="50" loading="lazy" />
        </div>
        <button class="mobile-close" type="button" data-close-menu aria-label="Fechar menu">×</button>
      </div>
      <nav class="mobile-nav" aria-label="Navegação móvel">
        <ul class="mobile-nav-list">
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#como-funciona">Como funciona</a></li>
          <li><a href="#vantagens">Vantagens</a></li>
          <li><a href="#sobre">Sobre</a></li>
          <li><a href="#avaliacoes">Avaliações</a></li>
          <li><a href="#contato">Contato</a></li>
        </ul>
      </nav>
      <a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-mobile-whatsapp">
        <svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/>
        </svg>
        <span>Falar no WhatsApp</span>
        <span class="btn-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="mobile-backdrop" data-close-menu></div>
  </div>

  <main id="main-content">
    <section class="hero-section" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <h1 class="hero-title" id="hero-title">
            <span class="hero-title-brand">Lavanderia Easy Wash</span><br />
            autoatendimento em Novo Hamburgo
          </h1>
          <p class="hero-description">
            Lave e seque roupas do dia a dia, edredons e cobertores com rapidez e economia. Sabão e amaciante profissionais inclusos, espaço climatizado e Wi-Fi de alta velocidade.
          </p>
          <div class="hero-actions">
            <a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary">
              <svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/>
              </svg>
              <span>Falar no WhatsApp</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="#servicos" class="btn btn-hero-secondary">
              <span>Conhecer serviços</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="hero-visual">
          <img src={asset(site.assets.hero)} alt="Máquinas modernas e toalhas limpas na Easy Wash" width="1448" height="1086" fetchpriority="high" loading="eager" />
        </div>
      </div>
      <div class="trust-bar" aria-label="Informações da Easy Wash">
        <div class="trust-item">
          <span class="trust-symbol gold" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            </svg>
          </span>
          <span><strong>Easy Wash</strong><small>Autoatendimento</small></span>
        </div>
        <div class="trust-item">
          <span class="trust-symbol" aria-hidden="true">
            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          <span><strong>Pronto em &lt;1h</strong><small>Lavagem e secagem</small></span>
        </div>
        <div class="trust-item">
          <span class="trust-symbol" aria-hidden="true">
            <svg class="icon-google" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.51h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.34z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
            </svg>
          </span>
          <span><strong>{site.rating} no Google</strong><small>Opinião de clientes</small></span>
        </div>
        <div class="trust-item">
          <span class="trust-symbol" aria-hidden="true">
            <svg class="icon-whatsapp" width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/>
            </svg>
          </span>
          <span><strong>WhatsApp</strong><small>{site.phoneDisplay}</small></span>
        </div>
      </div>
    </section>

    <section class="services-section" id="servicos" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header">
          <span class="section-eyebrow">NOSSOS SERVIÇOS</span>
          <h2 class="section-title" id="services-title">Autoatendimento completo para suas roupas</h2>
          <div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div>
        </header>
        <div class="services-grid">
          {services.map((service) => (
            <article class="service-card" id={`servico-${service.id}`}>
              <div class="service-image-wrap">
                <img src={asset(service.image)} alt={service.title} width="596" height="400" loading="lazy" style={`object-position: ${service.imagePosition}`} />
                <span class="service-icon" aria-hidden="true">
                  <img src={asset(service.icon)} alt="" width="72" height="72" loading="lazy" />
                </span>
              </div>
              <div class="service-content">
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href={whatsapp(service.query)} target="_blank" rel="noopener noreferrer" aria-label={`Saiba mais sobre ${service.title} no WhatsApp`}>
                  <span>Tirar dúvidas</span>
                  <span class="btn-arrow" aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section" id="sobre" aria-labelledby="about-title">
      <div class="container about-grid">
        <div class="about-composite">
          <img src={asset(site.assets.about)} alt="Ambiente limpo e aconchegante da Easy Wash" width="540" height="400" loading="lazy" />
        </div>
        <div class="about-copy">
          <span class="about-eyebrow">SOBRE A EASY WASH</span>
          <h2 id="about-title">Praticidade, conforto e tecnologia para a sua rotina.</h2>
          <p>A Easy Wash nasceu em Novo Hamburgo para revolucionar a forma como você cuida das suas roupas e roupas de cama. Em nosso espaço moderno de autoatendimento, você lava e seca peças do dia a dia ou edredons volumosos com máxima agilidade e economia.</p>
          <p>Sem estresse com varal, chuva ou contas altas de energia em casa: aproveite nosso ambiente climatizado, sossegado e com Wi-Fi ultrarrápido enquanto nossas máquinas profissionais cuidam de tudo com dosagem automática de produtos de ponta.</p>
        </div>
        <div class="about-benefits">
          {aboutBenefits.map((benefit) => (
            <div>
              <img src={asset(benefit.icon)} alt="" class="benefit-icon" width="54" height="54" loading="lazy" aria-hidden="true" />
              <strong set:html={benefit.title} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="institutional-section" id="vantagens" aria-labelledby="institutional-title">
      <div class="container institutional-container">
        <div class="institutional-content">
          <div class="institutional-eyebrow-wrap">
            <span class="institutional-eyebrow">POR QUE O AUTOATENDIMENTO?</span>
          </div>
          <h2 class="institutional-title" id="institutional-title">
            Economia de tempo,<br />energia e água para o<br /><span>seu dia a dia.</span>
          </h2>
          <p class="institutional-subtitle">
            Equipamentos profissionais de padrão internacional que lavam e secam com eficiência máxima e sem complicação.
          </p>
          <div class="institutional-differentials">
            <div class="inst-diff-item">
              <div class="inst-diff-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
              </div>
              <p>
                <span class="inst-line">Produtos inclusos</span>
                <span class="inst-line">dosagem automática</span>
              </p>
            </div>
            <div class="inst-diff-divider" aria-hidden="true"></div>
            <div class="inst-diff-item">
              <div class="inst-diff-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="2" width="18" height="20" rx="3"/><circle cx="12" cy="13" r="5"/><path d="M12 10a3 3 0 0 1 3 3"/>
                </svg>
              </div>
              <p>
                <span class="inst-line">Economia real</span>
                <span class="inst-line">até 4x mais rápido</span>
              </p>
            </div>
            <div class="inst-diff-divider" aria-hidden="true"></div>
            <div class="inst-diff-item">
              <div class="inst-diff-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
                </svg>
              </div>
              <p>
                <span class="inst-line">Espaço agradável</span>
                <span class="inst-line">climatizado &amp; Wi-Fi</span>
              </p>
            </div>
          </div>
          <div class="institutional-action-row">
            <a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-institutional-cta">
              <span>Tirar dúvidas no WhatsApp</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="institutional-support">
              <div class="inst-support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <p>
                Rua Caeté, 19 · Vila Rosa<br />Novo Hamburgo - RS.<br />
                <span class="inst-sma-pill">Aberto todos os dias</span>
              </p>
            </div>
          </div>
          <div class="institutional-bottom-bar" aria-hidden="true">
            <span class="inst-bar-line"></span>
            <span class="inst-bar-text">PRATICIDADE E CONFORTO PARA A SUA ROTINA</span>
            <span class="inst-bar-line inst-bar-long"></span>
          </div>
        </div>
      </div>
      <div class="institutional-visual">
        <img src={asset(site.assets.institutional)} alt="Ambiente e lavagem rápida na Easy Wash" width="1161" height="1354" loading="lazy" />
      </div>
    </section>

    <section class="process-section" id="como-funciona" aria-labelledby="process-title">
      <div class="container">
        <header class="section-header compact">
          <span class="section-eyebrow">COMO FUNCIONA</span>
          <h2 class="section-title" id="process-title">Prático, rápido e 100% autônomo</h2>
          <div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div>
        </header>
        <div class="process-grid">
          {processSteps.map((step, index) => (
            <article class="process-step">
              <span class="step-number">{index + 1}</span>
              <img src={asset(step.icon)} alt="" class="process-icon" width="92" height="92" loading="lazy" aria-hidden="true" />
              <div>
                <h3 set:html={step.title} />
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="reviews-section" id="avaliacoes" aria-labelledby="reviews-title">
      <div class="container">
        <div class="testimonial-heading">
          <div>
            <span class="section-eyebrow">AVALIAÇÕES</span>
            <h2 class="section-title" id="reviews-title">A opinião de quem já usa e recomenda</h2>
          </div>
          <div>
            <p>Relatos de clientes sobre a agilidade e conforto da Easy Wash.</p>
            <a class="google-rating" href={site.googleProfile} target="_blank" rel="noopener noreferrer">
              <svg class="google-g" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"></path>
